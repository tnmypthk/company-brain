# Company Brain — secrets template.
#
# LOCAL DEV:  copy this file to .streamlit/secrets.toml and fill in real
#             values. The real secrets.toml is gitignored — never commit it.
#             (You can also keep using a root .env file; either works.)
#
# STREAMLIT CLOUD:  do NOT upload a file. Paste these key = "value" lines into
#             the app's Settings → Secrets box in the Streamlit Cloud UI.
#             They're exposed to the app as st.secrets[...] at runtime.

# Required — Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY = "sk-ant-api03-REPLACE_WITH_YOUR_KEY"

# Optional — Slack ingestion. Bot token with scopes:
#   channels:read, channels:history, users:read
# (and the bot must be invited to each channel you ingest).
SLACK_BOT_TOKEN = "xoxb-REPLACE_WITH_YOUR_SLACK_BOT_TOKEN"

# Optional — force the "deployed server" code path while testing locally.
# When "true", the Google Drive/Gmail sections show the local-only notice
# instead of attempting the OAuth browser flow. Leave unset in normal use.
# RUNNING_ON_CLOUD = "true"

# NOTE: Google Drive / Gmail use file-based OAuth (credentials.json + a browser
# consent flow), which can't run on Streamlit Cloud — there are no secrets for
# them here. Those sources are local-only by design.
